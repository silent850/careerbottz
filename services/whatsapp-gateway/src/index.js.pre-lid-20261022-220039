
import { timingSafeEqual } from 'node:crypto';
import Fastify from 'fastify';
import pino from 'pino';
import makeWASocket, {
    DisconnectReason,
    useMultiFileAuthState,
} from '@whiskeysockets/baileys';
import qrcode from 'qrcode-terminal';

import { config } from './config.js';
import { handleWhatsAppMessage } from './inbound-handler.js';
import {
    getPairingState,
    updateStatus,
} from './pairing-state.js';

const app = Fastify({
    logger: {
        level: config.nodeEnv === 'production' ? 'info' : 'debug',
    },
});

let socket;
let reconnectTimer;
let shuttingDown = false;

function authenticateInternalRequest(request, reply, done) {
    const suppliedSecret = request.headers['x-gateway-secret'];

    if (
        typeof suppliedSecret !== 'string' ||
        suppliedSecret.length !== config.gatewaySharedSecret.length
    ) {
        reply.code(401).send({ message: 'Unauthorized.' });
        return;
    }

    const suppliedBuffer = Buffer.from(suppliedSecret, 'utf8');
    const expectedBuffer = Buffer.from(
        config.gatewaySharedSecret,
        'utf8',
    );

    if (!timingSafeEqual(suppliedBuffer, expectedBuffer)) {
        reply.code(401).send({ message: 'Unauthorized.' });
        return;
    }

    done();
}

app.get('/health', async () => ({
    status: 'ok',
    service: 'careerbot-tz-whatsapp-gateway',
    whatsapp: socket?.user ? 'connected' : 'disconnected',
}));

app.get(
    '/internal/pairing-status',
    {
        preHandler: authenticateInternalRequest,
    },
    async () => getPairingState(),
);

async function startWhatsApp() {
    if (shuttingDown) {
        return;
    }

    const { state, saveCreds } = await useMultiFileAuthState(
        config.whatsappSessionDir,
    );

    socket = makeWASocket({
        auth: state,
        logger: pino({ level: 'silent' }),
        browser: ['CareerBotTz', 'Chrome', '1.0.0'],
    });

    socket.ev.on('creds.update', saveCreds);

    socket.ev.on('connection.update', (update) => {
        const { connection, lastDisconnect, qr } = update;

        if (qr) {
            updateStatus('waiting_for_qr', { qr });
            app.log.info('A WhatsApp pairing QR code is available.');
            console.log('Scan this QR code with WhatsApp:');
            qrcode.generate(qr, { small: true });
        }

        if (connection === 'open') {
            updateStatus('connected', { qr: null });
            app.log.info('WhatsApp connection established.');
        }

        if (connection === 'close') {
            socket = undefined;

            const statusCode =
                lastDisconnect?.error?.output?.statusCode;

            const loggedOut =
                statusCode === DisconnectReason.loggedOut;

            if (loggedOut) {
                updateStatus('disconnected', { qr: null });

                app.log.error(
                    'WhatsApp logged out. Relink only when intended.',
                );

                return;
            }

            updateStatus('reconnecting', { qr: null });

            if (!reconnectTimer && !shuttingDown) {
                reconnectTimer = setTimeout(() => {
                    reconnectTimer = undefined;

                    startWhatsApp().catch((error) => {
                        app.log.error(
                            {
                                errorName: error?.name ?? 'Error',
                            },
                            'WhatsApp reconnection failed.',
                        );
                    });
                }, 3000);
            }
        }
    });

    // Diagnostic boundary: establish whether Baileys emits this event.
    socket.ev.on('messages.upsert', async (event) => {
        app.log.info(
            {
                eventReceived: true,
                eventType: event?.type ?? 'missing',
                messagesIsArray: Array.isArray(event?.messages),
                messageCount: Array.isArray(event?.messages)
                    ? event.messages.length
                    : 0,
                requestIdPresent: Boolean(event?.requestId),
            },
            'DIAGNOSTIC: Baileys messages.upsert event received.',
        );

        if (!Array.isArray(event?.messages)) {
            app.log.error(
                'DIAGNOSTIC: Event payload has no messages array.',
            );
            return;
        }

        if (event.type !== 'notify') {
            app.log.info(
                { eventType: event.type },
                'DIAGNOSTIC: Message batch skipped because it is not notify.',
            );
            return;
        }

        for (const message of event.messages) {
            const remoteJid = message?.key?.remoteJid;

            const chatType =
                typeof remoteJid !== 'string'
                    ? 'unknown'
                    : remoteJid.endsWith('@g.us')
                        ? 'group'
                        : remoteJid.endsWith('@s.whatsapp.net')
                            ? 'direct'
                            : 'other';

            app.log.info(
                {
                    hasKey: Boolean(message?.key),
                    chatType,
                    fromMe: Boolean(message?.key?.fromMe),
                    hasMessageContent: Boolean(message?.message),
                    messageTypes: Object.keys(message?.message ?? {}),
                    hasProviderMessageId: Boolean(message?.key?.id),
                },
                'DIAGNOSTIC: Baileys message payload received.',
            );

            try {
                app.log.info(
                    'DIAGNOSTIC: Calling inbound message handler.',
                );

                const result = await handleWhatsAppMessage(
                    message,
                    app.log,
                );

                app.log.info(
                    {
                        handlerCompleted: true,
                        ignored: result?.ignored ?? null,
                        duplicate: result?.result?.duplicate ?? null,
                    },
                    'DIAGNOSTIC: Inbound message handler completed.',
                );
            } catch (error) {
                app.log.error(
                    {
                        errorName: error?.name ?? 'Error',
                    },
                    'DIAGNOSTIC: Inbound message handler failed.',
                );
            }
        }
    });
}

try {
    await app.listen({
        host: '0.0.0.0',
        port: config.port,
    });

    app.log.info(
        `Gateway health endpoint listening on port ${config.port}.`,
    );

    await startWhatsApp();
} catch (error) {
    app.log.error(
        { errorName: error?.name ?? 'Error' },
        'WhatsApp gateway startup failed.',
    );

    process.exit(1);
}

async function shutdown() {
    if (shuttingDown) {
        return;
    }

    shuttingDown = true;

    if (reconnectTimer) {
        clearTimeout(reconnectTimer);
        reconnectTimer = undefined;
    }

    await app.close();
    process.exit(0);
}

process.once('SIGINT', shutdown);
process.once('SIGTERM', shutdown);
